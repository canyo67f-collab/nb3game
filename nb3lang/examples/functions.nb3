# Functions in NB3Lang

func greet(name):
    print("Hello, " + name + "!")

func factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

func fibonacci(n):
    if n <= 0:
        return 0
    if n == 1:
        return 1
    return fibonacci(n - 1) + fibonacci(n - 2)

greet("Player")

print("5! = " + factorial(5))
print("Fibonacci(10) = " + fibonacci(10))
